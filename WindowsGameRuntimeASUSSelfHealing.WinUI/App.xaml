<Application x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="HealthGoodBrush" Color="#DCFCE7" />
        <SolidColorBrush x:Key="HealthWarnBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="HealthBadBrush" Color="#FEE2E2" />
        <SolidColorBrush x:Key="HealthInfoBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardFillBrush" Color="#F8FAFC" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Application.Resources>
</Application>
