<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Margin="28,24,28,24" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="系统工具" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="缓存清理和内存清理可以直接跑。不会结束正在运行的程序，也不会动奥创修复、驱动和主板。" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="返回报告中心" Click="BackToReports_Click" VerticalAlignment="Top"/>
            </Grid>

            <ctrl:StatusBanner x:Name="Info" IsOpen="True" Severity="Informational" Title="系统工具" Message="先看下面两张卡片，点一下就能用。"/>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="系统缓存清理" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="清临时文件、缩略图、错误报告队列和回收站。正在使用的文件会跳过。不清理显卡着色器缓存，避免和显卡修复冲突。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CacheText" Text="正在扫描…" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button x:Name="ScanCacheButton" Content="重新扫描" Click="ScanCache_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                        <Button x:Name="CleanCacheButton" Content="立即清理" Click="CleanCache_Click" Background="#0F172A" Foreground="White" Margin="0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="内存清理" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="把闲置内存还给系统，效果和常见内存清理软件一样。不会关闭游戏、浏览器或任何正在运行的程序。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="MemoryText" Text="正在读取内存…" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Button x:Name="CleanMemoryButton" Grid.Column="1" Content="立即清理" Click="CleanMemory_Click" Background="#0F172A" Foreground="White" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="本软件检测缓存" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="只清奥创修复中心自己的事件缓存。修复记录和历史不会删。这和上面的系统缓存不是一回事。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="AppCacheText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="清理本软件缓存" Click="ClearCacheButton_Click" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="安全边界" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="• 不结束正在运行的程序，不强制解锁正在占用的文件。" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="• 不清理显卡着色器缓存，避免和游戏崩溃页的显卡修复冲突。"/>
                    <TextBlock Text="• 不自动运行 DDU，不卸载 GPU/芯片组驱动，不改 BIOS / ReBAR。"/>
                    <TextBlock Text="• 未知 ASUS 新版本只诊断，不套用旧 4151/4152 方案。" TextWrapping="Wrap"/>
                    <TextBlock Text="• 本软件检测缓存只删除事件游标和组件快照，不删除修复事务。" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="开发诊断" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="日常不用打开。深度检查、组件身份和架构信息仍保留，但不占用上面五个主入口。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="系统深度检查" Click="OpenDeepTest_Click"/>
                        <Button Content="组件身份诊断" Click="OpenIdentity_Click"/>
                        <Button Content="安全 / 架构信息" Click="OpenArchitecture_Click" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
