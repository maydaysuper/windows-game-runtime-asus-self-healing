<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <Grid Padding="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="报告中心" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="系统健康、修复事务、GPU/ReBAR 根因、Dump 分析与完整诊断包统一放在这里" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="高级设置" Click="OpenSettings_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SystemReportButton" Content="生成系统健康报告" Click="SystemReport_Click"/>
                <Button x:Name="RepairReportButton" Content="生成修复报告" Click="RepairReport_Click"/>
                <Button x:Name="VerifyButton" Content="执行最终验收" Click="VerifyButton_Click"/>
                <Button x:Name="DiagnosticZipButton" Content="生成完整诊断 ZIP" Click="DiagnosticZip_Click"/>
                <Button Content="打开报告文件夹" Click="OpenFolder_Click"/>
                <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click"/>
            </StackPanel>
            <ctrl:StatusBanner x:Name="Info" IsOpen="True" Severity="Informational" Title="报告中心" Message="报告默认保存在本机 LocalAppData，不会自动上传。"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="已生成报告" FontSize="17" FontWeight="SemiBold"/>
                    <ListView x:Name="ReportsList" Grid.Row="1" Margin="0,10,0,0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ReportItem}">
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,7" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedText}" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Margin="0,10,0,0" x:Name="OpenSelectedButton" Content="打开选中报告" IsEnabled="False" Click="OpenSelected_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="修复记录" FontSize="17" FontWeight="SemiBold"/>
                        <Button x:Name="ContinueButton" Grid.Column="1" Content="重启后续跑" Click="ContinueButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="WorkflowText" Grid.Row="1" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <ctrl:StatusBanner x:Name="TransactionInfo" Grid.Row="2" Margin="0,8,0,0" IsOpen="True" Severity="Informational" Title="修复事务" Message="正在同步 Transaction / Journal 状态。"/>
                    <ListView x:Name="TxList" Grid.Row="3" Margin="0,10,0,0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TransactionItem}">
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,7" Background="{Binding StatusBrush}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TransactionId}" FontFamily="Consolas" FontSize="11" Opacity="0.85"/>
                                        <TextBlock Text="{Binding LastDetail}" FontSize="12" TextWrapping="Wrap"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StartedAt}" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UpdatedAt}" FontSize="11" Opacity="0.7"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
