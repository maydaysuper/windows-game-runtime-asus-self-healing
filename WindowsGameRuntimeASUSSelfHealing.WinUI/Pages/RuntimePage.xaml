<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <Grid Padding="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="游戏运行库 / C++" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="检测并修复 VC++、DirectX 与游戏常用运行组件；下载包必须通过来源与签名校验" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OnlineButton" Content="联网对比" Click="OnlineButton_Click"/>
                <Button Content="生成 Dry Run" Click="PlanButton_Click"/>
                <Button x:Name="RepairButton" Content="安全修复" Click="RepairButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <ctrl:StatusBanner x:Name="RuntimeInfo" Grid.Row="1" Margin="0,18,0,0" IsOpen="True" Title="等待检测" Message="联网下载和签名验证全部在独立后台进程执行。"/>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="运行库状态" FontSize="17" FontWeight="SemiBold"/>
                    <ListView x:Name="RuntimeRows" Grid.Row="1" Margin="0,10,0,0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ComponentItem}">
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,7" Background="{Binding StatusBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Installed}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Target}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Detail}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Row="1" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Microsoft 官方包信任证据" FontSize="17" FontWeight="SemiBold"/>
                    <ListView x:Name="PackageRows" Grid.Row="1" Margin="0,10,0,0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RuntimePackageItem}">
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,7" Background="{Binding StatusBrush}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Version}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding FinalUri}" TextTrimming="CharacterEllipsis" Opacity="0.78"/>
                                        <TextBlock Text="{Binding Signer}" TextTrimming="CharacterEllipsis" Opacity="0.78"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
