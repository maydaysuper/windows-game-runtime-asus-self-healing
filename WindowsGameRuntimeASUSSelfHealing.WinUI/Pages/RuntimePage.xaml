<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <ScrollViewer>
        <StackPanel Margin="28,22,28,28">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="游戏运行库" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="看 C++ 运行库和 DirectX 能不能玩游戏。结果只有：正常、版本偏低、或需要安装。" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="重新检测" Click="RefreshButton_Click" VerticalAlignment="Top"/>
            </Grid>

            <ctrl:StatusBanner x:Name="RuntimeInfo" Margin="0,16,0,0" IsOpen="True" Title="等待检测" Message="点「重新检测」后，这里会直接告诉你要不要装运行库。"/>

            <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="检测结果" FontSize="16" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="RuntimeRows" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ComponentItem}">
                                <Border CornerRadius="10" Padding="14,12" Background="{Binding StatusBrush}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ResultLine}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayStatus}" Foreground="{Binding StatusForeground}" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
