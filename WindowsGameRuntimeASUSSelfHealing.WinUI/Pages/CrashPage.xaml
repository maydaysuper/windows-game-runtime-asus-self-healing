<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.CrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <ScrollViewer>
        <StackPanel Margin="26">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="游戏崩溃" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="看游戏为什么崩，以及显卡有没有问题。" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click"/>
                    <Button x:Name="GpuDiagnosisButton" Content="检查显卡" Click="GpuDiagnosisButton_Click"/>
                    <Button x:Name="AnalyzeButton" Content="分析崩溃文件" Click="AnalyzeDump_Click"/>
                </StackPanel>
            </Grid>

            <ctrl:StatusBanner x:Name="CrashInfo" IsOpen="True" Title="本机分析" Message="崩溃和显卡问题都在这台电脑上分析，不会上传。"/>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="显卡黑屏 / 爆显存" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuDiagnosisTitle" Text="等待检查" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="GpuDiagnosisSummary" Text="会看显存、驱动超时和崩溃文件，再给出结论。" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="GpuSafeRepairButton" Content="安全清理显卡缓存" IsEnabled="False" Click="GpuSafeRepairButton_Click"/>
                            <Button x:Name="OpenGpuReportButton" Content="打开报告" IsEnabled="False" Click="OpenGpuReportButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="大显存模式" FontWeight="SemiBold"/><TextBlock x:Name="RebarText" Text="等待检查" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="显存占用" FontWeight="SemiBold"/><TextBlock x:Name="GpuMemoryText" Text="等待检查" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="4" CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="显卡异常记录" FontWeight="SemiBold"/><TextBlock x:Name="GpuEventText" Text="等待检查" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="6" CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="最近崩溃文件" FontWeight="SemiBold"/><TextBlock x:Name="GpuDumpText" Text="等待检查" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="判断依据" FontWeight="SemiBold"/><TextBox x:Name="GpuEvidenceText" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="145" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="建议" FontWeight="SemiBold"/><TextBox x:Name="GpuRepairPlanText" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="145" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="崩溃文件结论" FontSize="17" FontWeight="SemiBold"/>
                            <Button x:Name="OpenDumpReportButton" Grid.Column="1" Content="打开分析报告" IsEnabled="False" Click="OpenDumpReport_Click"/>
                        </Grid>
                        <TextBlock x:Name="DumpReasonText" Grid.Row="1" Margin="0,12,0,0" Text="选择一个崩溃文件后，这里会直接给出原因。" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpFileText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpExceptionText" Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpModuleText" Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpEvidenceText" Grid.Row="5" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White">
                    <StackPanel>
                        <TextBlock Text="显卡状态" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox x:Name="GpuText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="210" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="近 7 天崩溃事件" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="CrashList" Grid.Row="1" Margin="0,8,0,0" Height="300" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CrashEventItem}">
                                <Border CornerRadius="10" Padding="14,12" Background="{Binding StatusBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Time}" FontSize="12" Opacity="0.75" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Process}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProviderText}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Opacity="0.86"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="8" Padding="8,3" Background="White" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding CountText}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White">
                    <StackPanel>
                        <TextBlock Text="给指定游戏自动保存崩溃文件" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="只对你填写的游戏生效，默认保留 3 份。" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="ExeNameBox" Text="game.exe"/>
                        <StackPanel Orientation="Horizontal"><Button Content="开启自动保存" Click="EnableDump_Click"/><Button Content="关闭自动保存" Click="DisableDump_Click"/></StackPanel>
                        <TextBox x:Name="WerText" IsReadOnly="True" AcceptsReturn="True" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White">
                    <StackPanel>
                        <TextBlock Text="最近崩溃分析" FontSize="16" FontWeight="SemiBold"/>
                        <ListView x:Name="DumpHistoryList" Height="170" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DumpAnalysisResult}">
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CoreReason}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Confidence}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="安全原则：不会因为 ReBAR 已开启就直接判定它是根因；不会自动 DDU、写 BIOS/ReBAR、卸载显示驱动、删除 DriverStore 或修改 TdrDelay/TdrDdiDelay。供电只能依据突然掉电/WHEA/TDR 形成“嫌疑”，Windows 软件不能直接测量 PSU 电压。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
