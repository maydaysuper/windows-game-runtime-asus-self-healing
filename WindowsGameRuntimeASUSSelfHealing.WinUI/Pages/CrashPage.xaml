<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.CrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <ScrollViewer>
        <StackPanel Padding="26">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="游戏崩溃 / GPU / ReBAR / Dump" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="把 ReBAR、显存/Shared GPU Memory、TDR、显示驱动、WHEA、LiveKernel 和 Dump 组合成一条根因证据链" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="刷新崩溃证据" Click="RefreshButton_Click"/>
                    <Button x:Name="GpuDiagnosisButton" Content="GPU / ReBAR 深度诊断" Click="GpuDiagnosisButton_Click"/>
                    <Button x:Name="AnalyzeButton" Content="选择 Dump 分析" Click="AnalyzeDump_Click"/>
                </StackPanel>
            </Grid>

            <ctrl:StatusBanner x:Name="CrashInfo" IsOpen="True" Title="按需加载" Message="事件日志使用 SQLite 增量游标；GPU/ReBAR 与 Dump 都只在本机分析，不上传。"/>

            <Border CornerRadius="14" Padding="18" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ReBAR 爆显存 / 黑屏根因诊断" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuDiagnosisTitle" Text="等待诊断" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="GpuDiagnosisSummary" Text="会综合显存压力、Shared GPU Memory、TDR、驱动、WHEA、LiveKernel 和 Dump；不会仅凭 ReBAR 开启就下结论。" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="GpuSafeRepairButton" Content="安全 GPU 修复" IsEnabled="False" Click="GpuSafeRepairButton_Click"/>
                            <Button x:Name="OpenGpuReportButton" Content="打开 GPU 报告" IsEnabled="False" Click="OpenGpuReportButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="ReBAR" FontWeight="SemiBold"/><TextBlock x:Name="RebarText" Text="UNKNOWN" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="Dedicated / Shared GPU Memory" FontWeight="SemiBold"/><TextBlock x:Name="GpuMemoryText" Text="等待采样" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="TDR / WHEA / Power" FontWeight="SemiBold"/><TextBlock x:Name="GpuEventText" Text="等待读取" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="3" CornerRadius="10" Padding="12" Background="{StaticResource CardFillBrush}"><StackPanel><TextBlock Text="最近 Dump" FontWeight="SemiBold"/><TextBlock x:Name="GpuDumpText" Text="等待读取" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="证据链" FontWeight="SemiBold"/><TextBox x:Name="GpuEvidenceText" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="145" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="处理 / 自动修复策略" FontWeight="SemiBold"/><TextBox x:Name="GpuRepairPlanText" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="145" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Dump 核心结论" FontSize="17" FontWeight="SemiBold"/>
                            <Button x:Name="OpenDumpReportButton" Grid.Column="1" Content="打开分析报告" IsEnabled="False" Click="OpenDumpReport_Click"/>
                        </Grid>
                        <TextBlock x:Name="DumpReasonText" Grid.Row="1" Margin="0,12,0,0" Text="选择一个 .dmp 后，这里会直接给出核心报错方向。" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpFileText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpExceptionText" Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpModuleText" Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DumpEvidenceText" Grid.Row="5" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                    <StackPanel>
                        <TextBlock Text="GPU / PnP" FontSize="17" FontWeight="SemiBold"/>
                        <TextBox x:Name="GpuText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="210" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="近 7 天崩溃事件" FontSize="17" FontWeight="SemiBold"/>
                    <ListView x:Name="CrashList" Grid.Row="1" Margin="0,10,0,0" Height="300" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CrashEventItem}">
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,7" Background="{Binding StatusBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2.6*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" VerticalAlignment="Center" FontSize="12"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Category}" FontWeight="SemiBold"/><TextBlock Text="{Binding Process}" FontSize="12" Opacity="0.8"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ProviderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="3" CornerRadius="8" Padding="8,3" Background="White" VerticalAlignment="Center"><TextBlock Text="{Binding CountText}" FontWeight="SemiBold"/></Border>
                                        <TextBlock Grid.Column="4" Text="{Binding Message}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                    <StackPanel>
                        <TextBlock Text="WER 自动 Dump" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="只对指定游戏 EXE 开启，默认保留 3 个 full dump。" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="ExeNameBox" Text="game.exe"/>
                        <StackPanel Orientation="Horizontal"><Button Content="启用 Dump" Click="EnableDump_Click"/><Button Content="关闭 Dump" Click="DisableDump_Click"/></StackPanel>
                        <TextBox x:Name="WerText" IsReadOnly="True" AcceptsReturn="True" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                    <StackPanel>
                        <TextBlock Text="最近 Dump 分析" FontSize="17" FontWeight="SemiBold"/>
                        <ListView x:Name="DumpHistoryList" Height="170" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DumpAnalysisResult}">
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CoreReason}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Confidence}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="安全原则：不会因为 ReBAR 已开启就直接判定它是根因；不会自动 DDU、写 BIOS/ReBAR、卸载显示驱动、删除 DriverStore 或修改 TdrDelay/TdrDdiDelay。供电只能依据突然掉电/WHEA/TDR 形成“嫌疑”，Windows 软件不能直接测量 PSU 电压。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
