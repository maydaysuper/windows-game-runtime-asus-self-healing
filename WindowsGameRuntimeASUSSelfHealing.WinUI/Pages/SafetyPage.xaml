<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.SafetyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <Grid Padding="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ASUS 奥创中心" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="专门处理 Armoury Crate / HAL / VGA / Holtek / ENE 的 4151、4152 与已验证组件问题" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="GroupCombo" Width="180" SelectedIndex="0">
                    <ComboBoxItem Content="自动识别" Tag="AUTO"/>
                    <ComboBoxItem Content="Patriot / VGA" Tag="PV"/>
                    <ComboBoxItem Content="Holtek" Tag="HOLTEK"/>
                    <ComboBoxItem Content="ENE M2" Tag="ENE"/>
                </ComboBox>
                <Button x:Name="PlanButton" Content="检测并生成方案" Click="AsusPlan_Click"/>
                <Button x:Name="ExecuteButton" Content="执行安全修复" IsEnabled="False" Click="ExecuteButton_Click"/>
            </StackPanel>
        </Grid>

        <ctrl:StatusBanner x:Name="PlanInfo" Grid.Row="1" Margin="0,18,0,0" IsOpen="True" Severity="Informational" Title="等待 ASUS 检测" Message="不会因为发现故障就直接修改系统。未知 ASUS 新版本只诊断，不套用旧修复。" />

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
            <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="安全检查" FontSize="17" FontWeight="SemiBold"/>
                    <ListView x:Name="PreflightList" Grid.Row="1" Margin="0,10,0,0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PreflightItem}">
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,7" Background="{Binding StatusBrush}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.82"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="检测结论 / 修复方案" FontSize="17" FontWeight="SemiBold"/>
                    <TextBox x:Name="PlanText" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
