<Page
    x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.Pages.SafetyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Controls"
    xmlns:models="clr-namespace:WindowsGameRuntimeASUSSelfHealing.WinUI.Models">
    <ScrollViewer>
        <StackPanel Margin="28,22,28,28">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="奥创中心" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="安装 501、装完打不开、更新失败，都可以在这里全自动修。笔记本和台式机都能用。" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <ComboBox x:Name="GroupCombo" Width="180" SelectedIndex="0">
                        <ComboBoxItem Content="自动识别" Tag="AUTO"/>
                        <ComboBoxItem Content="内存 / 显卡灯效" Tag="PV"/>
                        <ComboBoxItem Content="主板内存灯效" Tag="HOLTEK"/>
                        <ComboBoxItem Content="硬盘灯效" Tag="ENE"/>
                    </ComboBox>
                    <Button x:Name="PlanButton" Content="检测问题" Click="AsusPlan_Click"/>
                    <Button x:Name="AutoRepairButton" Content="全自动修复" IsEnabled="False" Click="AutoRepairButton_Click"/>
                    <Button x:Name="ExecuteButton" Content="执行灯效修复" IsEnabled="False" Click="ExecuteButton_Click" Margin="0"/>
                </WrapPanel>
            </Grid>

            <ctrl:StatusBanner x:Name="PlanInfo" Margin="0,16,0,0" IsOpen="True" Severity="Informational" Title="等待检测" Message="点「检测问题」后，这里会告诉你：501、打不开或更新错误要不要修。" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White">
                    <StackPanel>
                        <TextBlock Text="现在的问题" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="PreflightList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PreflightItem}">
                                    <Border CornerRadius="10" Padding="14,12" Background="{Binding StatusBrush}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ResultLine}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayStatus}" Foreground="{Binding StatusForeground}" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="14" Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Background="White" MinHeight="280">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="结论" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox x:Name="PlanText" Grid.Row="1" Margin="0,10,0,0" MinHeight="240" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
