<Window x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自愈中心"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1360" Height="860"
        MinWidth="960" MinHeight="640"
        Background="#F8FAFC"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Padding="14,10" Background="#0F172A">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left"
                       Source="pack://application:,,,/Assets/app.png"
                       Width="28" Height="28"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="自愈中心"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right"
                           Foreground="#93C5FD" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel x:Name="NavBar" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OverviewNav" Style="{StaticResource TopNavButton}" Content="系统健康" Tag="overview" Click="Nav_Click"/>
                    <Button x:Name="AsusNav" Style="{StaticResource TopNavButton}" Content="ASUS 奥创中心" Tag="asus" Click="Nav_Click"/>
                    <Button x:Name="RuntimeNav" Style="{StaticResource TopNavButton}" Content="游戏运行库" Tag="runtime" Click="Nav_Click"/>
                    <Button x:Name="CrashNav" Style="{StaticResource TopNavButton}" Content="崩溃 / Dump" Tag="crash" Click="Nav_Click"/>
                    <Button x:Name="ReportsNav" Style="{StaticResource TopNavButton}" Content="报告中心" Tag="reports" Click="Nav_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
        <Border Grid.Row="2" Padding="16,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪 · 后台任务按硬件自适应限流" Foreground="#64748B" FontSize="12"/>
                <TextBlock x:Name="BuildText" Foreground="#64748B" HorizontalAlignment="Right" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
