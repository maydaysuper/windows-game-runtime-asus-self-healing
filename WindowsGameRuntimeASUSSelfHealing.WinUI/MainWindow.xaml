<Window x:Class="WindowsGameRuntimeASUSSelfHealing.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 游戏运行环境自愈中心"
        Width="1360" Height="860"
        MinWidth="960" MinHeight="640"
        Background="#F8FAFC"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Padding="20,12" Background="#0F172A">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Windows 游戏运行环境自愈中心"
                           Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Foreground="#93C5FD" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <StackPanel x:Name="NavBar" Grid.Row="1" Orientation="Horizontal" Background="#E2E8F0" Height="52">
            <Button x:Name="OverviewNav" Content="系统健康" Tag="overview" Click="Nav_Click" Margin="16,10,0,10"/>
            <Button x:Name="AsusNav" Content="ASUS 奥创中心" Tag="asus" Click="Nav_Click" Margin="8,10,0,10"/>
            <Button x:Name="RuntimeNav" Content="游戏运行库" Tag="runtime" Click="Nav_Click" Margin="8,10,0,10"/>
            <Button x:Name="CrashNav" Content="崩溃 / Dump" Tag="crash" Click="Nav_Click" Margin="8,10,0,10"/>
            <Button x:Name="ReportsNav" Content="报告中心" Tag="reports" Click="Nav_Click" Margin="8,10,0,10"/>
        </StackPanel>
        <Frame x:Name="ContentFrame" Grid.Row="2" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
        <Border Grid.Row="3" Padding="16,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪 · 后台任务按硬件自适应限流" Foreground="#64748B" FontSize="12"/>
                <TextBlock x:Name="BuildText" Foreground="#64748B" HorizontalAlignment="Right" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
